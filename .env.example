# ------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit real secrets.
# Only NEXT_PUBLIC_* values are exposed to the browser — do not put
# private keys (Razorpay secret, database URLs, JWT secrets) here.
# ------------------------------------------------------------------

# Public URL of the storefront (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend REST API base URL, e.g. https://api.example.com/v1
# Leave EMPTY to run on the built-in mock services (frontend-first build).
NEXT_PUBLIC_API_BASE_URL=

# WhatsApp business number: country code + number, digits only (e.g. 91XXXXXXXXXX)
# If empty, the site uses +91 99985 55281 from src/config/site.ts
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Razorpay publishable key id (the secret stays on the backend)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Analytics & Search Console
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cloud object-storage / CDN hostname for product media (e.g. media.example.com)
NEXT_PUBLIC_MEDIA_HOST=

# Allow checkout without an account
NEXT_PUBLIC_ENABLE_GUEST_CHECKOUT=true

# Show sample testimonials & demo content while real content is being prepared.
# Set to false before launch.
NEXT_PUBLIC_SHOW_SAMPLE_CONTENT=true
